{
  "name": "dsh-mneme-llm",
  "version": "0.2.0",
  "description": "Memory, mood and a character of her own for an AI companion, in one SQLite file; and a DeepSeek Harness plugin that gives them to your companion.",
  "type": "module",
  "license": "MIT",
  "author": "RustColeone",
  "engines": {
    "node": ">=22.13"
  },
  "main": "plugin/index.js",
  "bin": {
    "dsh-mneme-llm": "bin/dsh-mneme-llm.js"
  },
  "exports": {
    ".": "./plugin/index.js",
    "./lib": "./lib/index.js",
    "./lib/meaning": "./lib/meaning/index.js",
    "./lib/*": "./lib/*.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "plugin",
    "starter.json.gz",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "mneme-llm",
    "llm",
    "memory",
    "long-term memory",
    "companion",
    "sqlite",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
